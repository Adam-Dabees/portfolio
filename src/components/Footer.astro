---
import { siteConfig } from "../config";

const year = new Date().getFullYear();

const links = [
  { id: "about", label: "About" },
  { id: "experience", label: "Experience" },
  { id: "work", label: "Work" },
  { id: "stack", label: "Stack" },
  { id: "leadership", label: "Leadership" },
  { id: "education", label: "Education" },
];

const social = [
  { href: `mailto:${siteConfig.social.email}`, label: "Email", external: false },
  { href: siteConfig.social.linkedin, label: "LinkedIn", external: true },
  { href: siteConfig.social.github, label: "GitHub", external: true },
].filter((item) => Boolean(item.href));
---

<footer id="contact" class="border-t border-line">
  <div class="mx-auto max-w-6xl px-6 sm:px-8 py-20 sm:py-24">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
      <div class="lg:col-span-7">
        <p class="label text-faint">Get in touch</p>
        <a
          href={`mailto:${siteConfig.social.email}`}
          class="group mt-4 inline-block text-2xl sm:text-4xl font-medium tracking-tight text-ink break-all"
        >
          {siteConfig.social.email}
          <span
            class="block h-px mt-2 bg-accent origin-left scale-x-0 group-hover:scale-x-100 transition-transform duration-500 ease-out"
          ></span>
        </a>
        <p class="mt-6 max-w-md prose-body text-[0.95rem] leading-relaxed text-dim">
          {siteConfig.availability}. Happy to talk about systems work, machine vision, or
          infrastructure.
        </p>
      </div>

      <div class="lg:col-span-3">
        <p class="label text-faint">Index</p>
        <ul class="mt-4 space-y-2">
          {
            links.map((link) => (
              <li>
                <a
                  href={`#${link.id}`}
                  class="text-sm text-dim hover:text-ink transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="lg:col-span-2">
        <p class="label text-faint">Elsewhere</p>
        <ul class="mt-4 space-y-2">
          {
            social.map((item) => (
              <li>
                <a
                  href={item.href}
                  target={item.external ? "_blank" : undefined}
                  rel={item.external ? "noopener noreferrer" : undefined}
                  class="text-sm text-dim hover:text-ink transition-colors"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div
      class="mt-16 pt-6 border-t border-line flex flex-wrap items-center justify-between gap-3"
    >
      <p class="nums text-xs text-faint">© {year} {siteConfig.name}</p>
      <p class="text-xs text-faint">Built with Astro &amp; Tailwind</p>
    </div>
  </div>
</footer>
