---
import { siteConfig } from "../config";

const social = [
  siteConfig.social?.email && {
    href: `mailto:${siteConfig.social.email}`,
    label: "Email",
    external: false,
    path: "M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10zM3 7l9 6l9 -6",
  },
  siteConfig.social?.linkedin && {
    href: siteConfig.social.linkedin,
    label: "LinkedIn",
    external: true,
    path: "M8 11v5M8 8v.01M12 16v-5M16 16v-3a2 2 0 1 0 -4 0M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z",
  },
  siteConfig.social?.github && {
    href: siteConfig.social.github,
    label: "GitHub",
    external: true,
    path: "M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5",
  },
].filter(Boolean) as { href: string; label: string; external: boolean; path: string }[];
---

<section
  id="top"
  class="relative isolate overflow-hidden min-h-[100svh] flex flex-col justify-center pt-24 pb-14"
>
  <div class="absolute inset-0 -z-10 grid-field" aria-hidden="true"></div>
  <div class="absolute inset-0 -z-10 aurora" aria-hidden="true"></div>

  <div class="mx-auto w-full max-w-6xl px-6 sm:px-8">
    <!-- Status line -->
    <div class="flex flex-wrap items-center gap-x-3 gap-y-2 reveal">
      <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-accent text-accent pulse"
      ></span>
      <span class="label text-dim">Currently</span>
      <span class="text-sm text-ink">{siteConfig.now.role}</span>
      <span class="text-faint" aria-hidden="true">·</span>
      <span class="text-sm text-accent">{siteConfig.now.org}</span>
    </div>

    <h1
      class="mt-7 text-[clamp(2.75rem,9vw,7rem)] leading-[0.95] font-medium tracking-[-0.045em] [word-spacing:-0.18em] text-ink reveal"
      style="transition-delay: 80ms"
    >
      {siteConfig.name}
    </h1>

    <p
      class="mt-7 max-w-2xl prose-body text-lg sm:text-xl leading-relaxed text-dim reveal"
      style="transition-delay: 160ms"
    >
      I build and debug systems where failure is expensive: machine vision on live
      production hardware, distributed infrastructure, and the tooling that keeps both
      honest.
    </p>

    <!-- Actions -->
    <div class="mt-9 flex flex-wrap items-center gap-3 reveal" style="transition-delay: 240ms">
      <a
        href={`mailto:${siteConfig.social.email}`}
        class="group inline-flex items-center gap-2 rounded-full border border-line-strong px-5 py-2.5 text-sm text-ink hover:bg-inset hover:border-accent transition-colors"
      >
        Get in touch
        <svg
          class="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-0.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </a>

      <div class="flex items-center gap-1">
        {
          social.map((item) => (
            <a
              href={item.href}
              aria-label={item.label}
              target={item.external ? "_blank" : undefined}
              rel={item.external ? "noopener noreferrer" : undefined}
              class="grid place-items-center h-10 w-10 rounded-full text-dim hover:text-accent hover:bg-inset transition-colors"
            >
              <svg
                class="h-[1.15rem] w-[1.15rem]"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d={item.path} />
              </svg>
            </a>
          ))
        }
      </div>

      <span class="ml-1 inline-flex items-center gap-2 text-xs text-faint">
        <span class="h-px w-4 bg-line-strong"></span>
        {siteConfig.availability}
      </span>
    </div>
  </div>

  <!-- Data strip: the numbers, stated once, quietly -->
  <div class="mt-16 sm:mt-20 border-t border-line reveal" style="transition-delay: 320ms">
    <div class="mx-auto w-full max-w-6xl px-6 sm:px-8">
      <dl class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 divide-y sm:divide-y-0 sm:divide-x divide-line">
        {
          siteConfig.highlights.map((item) => (
            <div class="py-5 sm:py-6 sm:px-6 sm:first:pl-0 sm:last:pr-0">
              <dt class="flex items-baseline gap-1">
                <span class="nums text-2xl sm:text-3xl font-medium tracking-tight text-ink">
                  {item.value}
                </span>
                {item.unit && <span class="nums text-sm text-faint">{item.unit}</span>}
              </dt>
              <dd class="mt-1.5 text-xs sm:text-[0.8rem] text-dim leading-relaxed">
                {item.label}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
