---
import { siteConfig } from "../config";
import SectionHeading from "./SectionHeading.astro";
import { marked } from "../lib/text";

const schools = siteConfig.education ?? [];
---

{
  schools.length > 0 && (
    <section id="education" class="mx-auto max-w-6xl px-6 sm:px-8 py-24 sm:py-32">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">
        <SectionHeading index="06" title="Education" />

        <div class="lg:col-span-8 space-y-8">
          {schools.map((school, index) => (
            <article
              class="reveal border-t border-line pt-8"
              style={`transition-delay: ${Math.min(index * 80, 160)}ms`}
            >
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <h3 class="text-xl sm:text-2xl font-medium tracking-tight text-ink">
                  {school.school}
                </h3>
                <span class="nums label text-faint ml-auto">{school.dateRange}</span>
              </div>

              <p class="mt-1.5 text-sm text-accent">{school.degree}</p>
              <p class="mt-1 text-xs text-faint">{school.location}</p>

              <ul class="mt-5 space-y-3">
                {school.achievements.map((achievement) => (
                  <li class="flex gap-3">
                    <span class="mt-[0.7em] h-px w-3 shrink-0 bg-line-strong" aria-hidden="true" />
                    <span class="prose-body text-[0.95rem] leading-relaxed text-dim">
                      {marked(achievement).map((segment) =>
                        segment.mark ? <span class="metric">{segment.text}</span> : segment.text,
                      )}
                    </span>
                  </li>
                ))}
              </ul>

              {school.coursework?.length > 0 && (
                <div class="mt-7">
                  <p class="label text-faint">Relevant coursework</p>
                  <ul class="mt-3 flex flex-wrap gap-x-2 gap-y-2">
                    {school.coursework.map((course) => (
                      <li class="text-[0.8rem] leading-none text-dim border border-line rounded-full px-3 py-1.5 hover:border-line-strong hover:text-ink transition-colors">
                        {course}
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>
  )
}
