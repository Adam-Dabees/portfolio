---
import { siteConfig } from "../config";
import SectionHeading from "./SectionHeading.astro";
import { marked } from "../lib/text";

const roles = siteConfig.experience ?? [];
---

{
  roles.length > 0 && (
    <section id="experience" class="mx-auto max-w-6xl px-6 sm:px-8 py-24 sm:py-32">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">
        <SectionHeading index="02" title="Experience" />

        <div class="lg:col-span-8">
          <ol class="relative border-l border-line pl-7 sm:pl-10 space-y-14">
            {roles.map((role, index) => (
              <li class="relative reveal" style={`transition-delay: ${Math.min(index * 70, 210)}ms`}>
                {/* Timeline node */}
                <span
                  class={`absolute -left-[calc(1.75rem_+_3.5px)] sm:-left-[calc(2.5rem_+_3.5px)] top-2 h-[7px] w-[7px] rounded-full ${
                    role.current ? "bg-accent text-accent pulse" : "bg-line-strong"
                  }`}
                  aria-hidden="true"
                />

                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                  <h3 class="text-xl sm:text-2xl font-medium tracking-tight text-ink">
                    {role.company}
                  </h3>
                  {role.website && (
                    <a
                      href={role.website}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-faint hover:text-accent transition-colors"
                      aria-label={`${role.company} website`}
                    >
                      <svg
                        class="h-3.5 w-3.5"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M7 17L17 7M17 7H7M17 7V17" />
                      </svg>
                    </a>
                  )}
                  <span class="nums label text-faint ml-auto">{role.dateRange}</span>
                </div>

                <p class="mt-1.5 text-sm text-accent">{role.title}</p>

                <p class="mt-1 text-xs text-faint">
                  {role.context}
                  <span class="mx-1.5" aria-hidden="true">
                    ·
                  </span>
                  {role.location}
                </p>

                <ul class="mt-5 space-y-3">
                  {role.bullets.map((bullet) => (
                    <li class="flex gap-3">
                      <span
                        class="mt-[0.7em] h-px w-3 shrink-0 bg-line-strong"
                        aria-hidden="true"
                      />
                      <span class="prose-body text-[0.95rem] sm:text-base leading-relaxed text-dim">
                        {marked(bullet).map((segment) =>
                          segment.mark ? (
                            <span class="metric">{segment.text}</span>
                          ) : (
                            segment.text
                          ),
                        )}
                      </span>
                    </li>
                  ))}
                </ul>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>
  )
}
