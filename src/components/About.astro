---
import { siteConfig } from "../config";
import SectionHeading from "./SectionHeading.astro";

const paragraphs = siteConfig.aboutMe.split("\n\n");

const facts = [
  { key: "Based in", value: siteConfig.now.location },
  { key: "Focus", value: "Machine vision, distributed systems, infrastructure" },
  { key: "Open to", value: siteConfig.availability.replace("Available ", "") },
];
---

<section id="about" class="mx-auto max-w-6xl px-6 sm:px-8 py-24 sm:py-32">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">
    <SectionHeading index="01" title="About" />

    <div class="lg:col-span-8">
      <div class="prose-body space-y-6 text-lg sm:text-xl leading-[1.65] text-dim reveal">
        {
          paragraphs.map((paragraph) => (
            <p class="[&:first-child]:text-ink">{paragraph}</p>
          ))
        }
      </div>

      <dl
        class="mt-12 grid grid-cols-1 sm:grid-cols-3 gap-px bg-line border border-line reveal"
        style="transition-delay: 100ms"
      >
        {
          facts.map((fact) => (
            <div class="bg-canvas p-5">
              <dt class="label text-faint">{fact.key}</dt>
              <dd class="mt-2 text-sm text-ink leading-relaxed">{fact.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
