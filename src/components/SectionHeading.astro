---
interface Props {
  index: string;
  title: string;
  note?: string;
}

const { index, title, note } = Astro.props;
---

<div class="lg:col-span-4 lg:sticky lg:top-32 reveal">
  <div class="flex items-baseline gap-3">
    <span class="label nums text-accent">{index}</span>
    <span class="h-px flex-1 lg:flex-none lg:w-10 bg-line"></span>
  </div>
  <h2
    class="mt-4 text-3xl sm:text-4xl lg:text-5xl font-medium tracking-tight text-ink"
  >
    {title}
  </h2>
  {note && <p class="mt-3 text-sm text-faint leading-relaxed max-w-[26ch]">{note}</p>}
</div>
