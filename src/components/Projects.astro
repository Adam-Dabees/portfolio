---
import { siteConfig } from "../config";
import SectionHeading from "./SectionHeading.astro";
import { marked } from "../lib/text";

const projects = siteConfig.projects ?? [];
---

{
  projects.length > 0 && (
    <section id="work" class="mx-auto max-w-6xl px-6 sm:px-8 py-24 sm:py-32">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">
        <SectionHeading
          index="03"
          title="Selected work"
          note="Things I built end to end. The numbers are measured, not estimated."
        />

        <div class="lg:col-span-8">
          <div class="border-t border-line">
            {projects.map((project, index) => {
              const Wrapper = project.link ? "a" : "div";
              const linkProps = project.link
                ? { href: project.link, target: "_blank", rel: "noopener noreferrer" }
                : {};

              return (
                <Wrapper
                  {...linkProps}
                  class={`group block border-b border-line py-8 sm:py-10 reveal transition-colors duration-300 ${
                    project.link ? "hover:border-line-strong" : ""
                  }`}
                  style={`transition-delay: ${Math.min(index * 60, 240)}ms`}
                >
                  <div class="flex items-start gap-4 sm:gap-6">
                    <span class="label nums text-faint pt-2 hidden sm:block">
                      {String(index + 1).padStart(2, "0")}
                    </span>

                    <div class="flex-1 min-w-0">
                      <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                        <h3 class="text-xl sm:text-2xl font-medium tracking-tight text-ink group-hover:text-accent transition-colors">
                          {project.name}
                        </h3>
                        <span class="text-xs text-faint">{project.tagline}</span>
                        <span class="nums label text-faint ml-auto">{project.year}</span>
                      </div>

                      <p class="mt-4 max-w-2xl prose-body text-[0.95rem] sm:text-base leading-relaxed text-dim">
                        {marked(project.description).map((segment) =>
                          segment.mark ? (
                            <span class="metric">{segment.text}</span>
                          ) : (
                            segment.text
                          ),
                        )}
                      </p>

                      {project.skills?.length > 0 && (
                        <ul class="mt-5 flex flex-wrap gap-x-2 gap-y-2">
                          {project.skills.map((skill) => (
                            <li class="text-[0.7rem] tracking-wide text-faint border border-line rounded px-2 py-1 group-hover:text-dim transition-colors">
                              {skill}
                            </li>
                          ))}
                        </ul>
                      )}
                    </div>

                    {project.link && (
                      <span
                        class="shrink-0 mt-1.5 text-faint group-hover:text-accent transition-all duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                        aria-hidden="true"
                      >
                        <svg
                          class="h-4 w-4"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.6"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <path d="M7 17L17 7M17 7H7M17 7V17" />
                        </svg>
                      </span>
                    )}
                  </div>
                </Wrapper>
              );
            })}
          </div>
        </div>
      </div>
    </section>
  )
}
