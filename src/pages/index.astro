---
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Experience from "../components/Experience.astro";
import Projects from "../components/Projects.astro";
import Stack from "../components/Stack.astro";
import Leadership from "../components/Leadership.astro";
import Education from "../components/Education.astro";
import Footer from "../components/Footer.astro";
import PongSignature from "../components/PongSignature.astro";
import { siteConfig } from "../config";
import "../styles/global.css";

const pageTitle = `${siteConfig.name} · ${siteConfig.now.role}`;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{pageTitle}</title>
    <meta name="description" content={siteConfig.description} />
    <meta name="author" content={siteConfig.name} />
    <meta name="robots" content="index, follow" />
    <meta
      name="keywords"
      content="Adam Dabees, software engineer, machine vision, computer vision, distributed systems, Kubernetes, infrastructure, McMaster University, portfolio"
    />
    <link rel="canonical" href="https://adamdabees.com" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={siteConfig.description} />
    <meta property="og:url" content="https://adamdabees.com" />
    <meta property="og:site_name" content={`${siteConfig.name} Portfolio`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={siteConfig.description} />

    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" id="theme-color" content="#0a0b0d" />
    <meta name="apple-mobile-web-app-capable" content="yes" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@300;400;500;600&family=IBM+Plex+Sans:wght@300;400;500&display=swap"
      rel="stylesheet"
    />

    <!-- Resolve the theme before first paint so there is no flash. -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var theme =
            stored ||
            (window.matchMedia("(prefers-color-scheme: light)").matches
              ? "light"
              : "dark");
          document.documentElement.dataset.theme = theme;
          var meta = document.getElementById("theme-color");
          if (meta) meta.setAttribute("content", theme === "light" ? "#fbfbf9" : "#0a0b0d");
        } catch (e) {
          document.documentElement.dataset.theme = "dark";
        }

        // Safety net: content is hidden until the reveal observer runs. If the
        // module script never executes (bundle error, blocked, whatever), show
        // everything rather than serving a blank page.
        setTimeout(function () {
          if (document.querySelector(".reveal.in")) return;
          document.querySelectorAll(".reveal").forEach(function (node) {
            node.classList.add("in");
          });
        }, 3000);
      })();
    </script>

    <!-- Without JS the reveal animations never fire, so show everything. -->
    <noscript>
      <style>
        .reveal {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </head>

  <body>
    <a
      href="#about"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:rounded focus:bg-raised focus:px-4 focus:py-2 focus:text-sm focus:text-ink focus:border focus:border-line-strong"
    >
      Skip to content
    </a>

    <Header />

    <main>
      <Hero />
      <About />
      <Experience />
      <Projects />
      <Stack />
      <Leadership />
      <Education />
    </main>

    <Footer />
    <PongSignature />

    <script>
      // Reveal-on-scroll. One observer, unobserving as it goes.
      const revealables = document.querySelectorAll(".reveal");

      const revealAll = () => revealables.forEach((el) => el.classList.add("in"));

      try {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          revealAll();
        } else {
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                entry.target.classList.add("in");
                observer.unobserve(entry.target);
              });
            },
            { rootMargin: "0px 0px -8% 0px", threshold: 0.05 },
          );

          revealables.forEach((el) => observer.observe(el));
        }
      } catch {
        revealAll();
      }

      // Keep the browser chrome color in step with the theme toggle.
      const meta = document.getElementById("theme-color");
      new MutationObserver(() => {
        meta?.setAttribute(
          "content",
          document.documentElement.dataset.theme === "light" ? "#fbfbf9" : "#0a0b0d",
        );
      }).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["data-theme"],
      });
    </script>
  </body>
</html>
